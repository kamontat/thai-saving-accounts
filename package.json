{
	"name": "saving-accounts",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run ./src/index.ts",
		"profile": "bun run --heap-prof-md --heap-prof-dir=.pprof --cpu-prof-md --cpu-prof-dir=.pprof ./src/index.ts",
		"start": "DEBUG=sav:*,-sav:*:debug bun dev",
		"debug": "DEBUG=sav:* bun dev",
		"check": "biome check",
		"fix": "biome check --write --unsafe"
	},
	"dependencies": {
		"debug": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kcconfigs/biome": "2.0.3",
		"@kcconfigs/tsconfig": "1.0.3",
		"@types/bun": "latest",
		"@types/debug": "4.1.13"
	},
	"peerDependencies": {
		"typescript": "^6"
	}
}
